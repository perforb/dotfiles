[user]
  # Identity lives in ~/.gitconfig.local; refuse to commit without one
  useConfigOnly = true
[core]
  editor = vim
[pull]
  rebase = false
[init]
  defaultBranch = main

[alias]
  st = status
  br = branch
  co = checkout

# Machine-local settings such as [user] (not tracked); included last so they win
[include]
  path = ~/.gitconfig.local
